#!/bin/sh
set -a
. ./src/main/resources/.env
set +a

COMPOSE="docker compose -f ../../docker-compose.yml --env-file ./src/main/resources/.env"

if ! $COMPOSE ps --services --filter status=running | grep -q "^db$"; then
  $COMPOSE up -d db
  until $COMPOSE exec -T db pg_isready -q 2>/dev/null; do
    sleep 1
  done
fi

JAVA_HOME=/opt/homebrew/opt/openjdk@21 ./mvnw spring-boot:run -Dspring-boot.run.profiles=dev
